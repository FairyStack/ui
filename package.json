{
  "name": "@fairystack/workspace",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "3.9.0",
    "turbo": "2.10.0",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@11.9.0",
  "engineStrict": true,
  "engines": {
    "node": ">=22"
  }
}
